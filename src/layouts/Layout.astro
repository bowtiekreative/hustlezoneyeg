---
import '../styles/global.css';
import MegaMenu from '../components/MegaMenu.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Hustle Zone — run the whole hustle from one place', ogImage } = Astro.props;

const navItems = [
  { label: 'Features', href: '/#features' },
  { label: 'How It Works', href: '/#how' },
  { label: 'Plans', href: '/#pricing' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Hustle Zone" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#07090D" />

    <!-- SEO -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://hustlezoneyeg.com" />
    <meta property="og:site_name" content="Hustle Zone" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />

    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MVTEQ4388T"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MVTEQ4388T');
    </script>

    <!-- Emailit -->
    <script src="https://sdk.emailit.app/sdk.js" defer></script>
  </head>
  <body>
    <MegaMenu
      brand="Hustle Zone"
      items={navItems}
      cta="Book a Demo"
      ctaHref="/demo"
    />

    <main>
      <slot />
    </main>

    <!-- ── LAKA Footer ── -->
    <footer class="lka-footer">
      <div class="container lka-footer-inner">
        <div class="lka-footer-brand">
          <span class="lka-footer-seal">HZ</span>
          <p class="lka-footer-tag">The operating system for people building something on the side or on their own.</p>
          <p class="lka-footer-email">
            <a href="mailto:hello@hustlezoneyeg.com">hello@hustlezoneyeg.com</a>
          </p>
        </div>
        <div class="lka-footer-links">
          <div class="lka-f-col">
            <h4 class="lka-f-heading">Pages</h4>
            <nav>
              <a href="/">Home</a>
              <a href="/#features">Features</a>
              <a href="/#pricing">Plans</a>
              <a href="/#faq">FAQ</a>
            </nav>
          </div>
          <div class="lka-f-col">
            <h4 class="lka-f-heading">Legal</h4>
            <nav>
              <a href="/privacy">Privacy Policy</a>
              <a href="/terms">Terms &amp; Conditions</a>
              <a href="/sitemap.xml">Sitemap</a>
            </nav>
          </div>
          <div class="lka-f-col">
            <h4 class="lka-f-heading">Powered By</h4>
            <nav>
              <a href="https://bowtiekreative.com" target="_blank" rel="noopener">Bow Tie Kreative</a>
            </nav>
          </div>
        </div>
      </div>
      <div class="container lka-footer-btm">
        <p>&copy; {new Date().getFullYear()} Hustle Zone YEG. All rights reserved.</p>
      </div>
    </footer>

    <script>
      // Intersection Observer for reveal animations
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
            }
          });
        }, { threshold: 0.15 });
        document.querySelectorAll('.lka-reveal, .lka-reveal-stagger').forEach(el => observer.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  /* ── LAKA Footer ── */
  .lka-footer {
    border-top: 1px solid var(--lka-hairline-soft);
    padding: var(--space-9) 0 var(--space-6);
    margin-top: var(--section-gap);
    background: var(--lka-surface);
  }
  .lka-footer-inner {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-9);
    margin-bottom: var(--space-7);
  }
  .lka-footer-seal {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: var(--radius-control);
    background: var(--lka-accent); color: #FFFFFF;
    font-weight: var(--weight-bold); font-size: 16px;
    margin-bottom: var(--space-4);
  }
  .lka-footer-tag {
    color: var(--lka-muted); font-size: var(--text-small);
    max-width: 360px; line-height: 1.6;
  }
  .lka-footer-email { margin-top: var(--space-3); }
  .lka-footer-email a {
    font-size: var(--text-small);
    color: var(--lka-accent);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .lka-footer-email a:hover { color: var(--lka-accent-hover); }
  .lka-footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gutter);
  }
  .lka-f-heading {
    font-size: var(--text-micro); letter-spacing: var(--track-micro);
    text-transform: uppercase; color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .lka-f-col nav { display: flex; flex-direction: column; gap: var(--space-2); }
  .lka-f-col a {
    font-size: var(--text-small); color: var(--text-body);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    width: fit-content;
  }
  .lka-f-col a:hover { color: var(--text-heading); }

  .lka-footer-btm {
    padding-top: var(--space-6);
    border-top: 1px solid var(--lka-hairline-soft);
  }
  .lka-footer-btm p {
    font-size: var(--text-small); color: var(--lka-muted);
  }

  @media (max-width: 768px) {
    .lka-footer-inner { grid-template-columns: 1fr; gap: var(--space-6); }
    .lka-footer-links { grid-template-columns: 1fr 1fr; }
  }
</style>