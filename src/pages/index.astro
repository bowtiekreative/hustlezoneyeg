---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hustle Zone YEG — run the whole hustle from one place">
  <!-- ── Hero ── -->
  <section class="section lka-hero">
    <div class="container lka-hero-grid">
      <div class="lka-hero-text lka-reveal">
        <span class="lka-label">Business operating system</span>
        <h1 class="lka-hero-title">Your <span class="lka-acc">whole hustle</span>.<br>One dashboard.</h1>
        <p class="lka-hero-desc">Clients, projects, money, products, socials and email in a single dashboard. Built for people building something on the side — or on their own.</p>
        <div class="lka-hero-actions">
          <a href="/demo" class="lka-btn lka-btn-accent lka-btn-lg">Book a Demo</a>
          <a href="/#features" class="lka-btn lka-btn-outline lka-btn-lg">See Features</a>
        </div>
      </div>
      <div class="lka-hero-media lka-reveal">
        <div class="lka-frame">
          <div class="lka-notch"></div>
          <div class="lka-dash">
            <div class="lka-dash-row"><span class="lka-dash-lbl">Revenue</span><span class="lka-dash-val lka-acc">$12,430</span></div>
            <div class="lka-dash-row"><span class="lka-dash-lbl">Active Clients</span><span class="lka-dash-val">8</span></div>
            <div class="lka-dash-row"><span class="lka-dash-lbl">Open Tasks</span><span class="lka-dash-val">24</span></div>
            <div class="lka-dash-row"><span class="lka-dash-lbl">Messages</span><span class="lka-dash-val">7</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features ── -->
  <section id="features" class="section lka-features">
    <div class="container">
      <span class="lka-label lka-reveal">Features</span>
      <h2 class="lka-sec-title lka-reveal">Everything you need to<br><span class="lka-acc">run your hustle</span>.</h2>
      <div class="lka-feat-grid lka-reveal-stagger in-view">
        <div class="lka-card">
          <div class="lka-card-icon">📋</div>
          <h3>Project Management</h3>
          <p>Track every client project from brief to delivery. Kanban boards, timelines, file sharing.</p>
        </div>
        <div class="lka-card">
          <div class="lka-card-icon">💰</div>
          <h3>Invoicing & Payments</h3>
          <p>Send invoices, accept payments, track what's owed. No more spreadsheets.</p>
        </div>
        <div class="lka-card">
          <div class="lka-card-icon">📧</div>
          <h3>Email Integration</h3>
          <p>Connect your inbox. Send, receive, and track emails without leaving the dashboard.</p>
        </div>
        <div class="lka-card">
          <div class="lka-card-icon">📱</div>
          <h3>Social Media</h3>
          <p>Schedule posts, track engagement, manage all your accounts from one place.</p>
        </div>
        <div class="lka-card">
          <div class="lka-card-icon">📊</div>
          <h3>Analytics</h3>
          <p>See what's working. Revenue trends, client activity, and growth metrics at a glance.</p>
        </div>
        <div class="lka-card">
          <div class="lka-card-icon">🔗</div>
          <h3>Client Portal</h3>
          <p>Give clients a white-label portal to see progress, approve work, and communicate.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How It Works ── -->
  <section id="how" class="section lka-how">
    <div class="container">
      <span class="lka-label lka-reveal">How it works</span>
      <h2 class="lka-sec-title lka-reveal">Set up in minutes.<br><span class="lka-acc">Start in hours</span>.</h2>
      <div class="lka-steps lka-reveal-stagger in-view">
        <div class="lka-step">
          <span class="lka-step-num">01</span>
          <h3>Book a Demo</h3>
          <p>See the platform in action. We'll walk through your specific use case.</p>
        </div>
        <div class="lka-step-arr">→</div>
        <div class="lka-step">
          <span class="lka-step-num">02</span>
          <h3>Get Onboarded</h3>
          <p>We set up your workspace, connect your tools, and import your data.</p>
        </div>
        <div class="lka-step-arr">→</div>
        <div class="lka-step">
          <span class="lka-step-num">03</span>
          <h3>Run Your Hustle</h3>
          <p>Manage everything from one dashboard. Clients, projects, money — all in sync.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Pricing ── -->
  <section id="pricing" class="section lka-pricing">
    <div class="container">
      <span class="lka-label lka-reveal">Plans</span>
      <h2 class="lka-sec-title lka-reveal">Simple pricing.<br><span class="lka-acc">No surprises</span>.</h2>
      <div class="lka-price-grid lka-reveal-stagger in-view">
        <div class="lka-price-card">
          <h3>Starter</h3>
          <div class="lka-price-amt"><span class="lka-price-num">$29</span><span class="lka-price-per">/mo</span></div>
          <ul class="lka-price-feats">
            <li>Up to 3 clients</li>
            <li>5 projects</li>
            <li>Basic invoicing</li>
            <li>Email integration</li>
            <li>Community support</li>
          </ul>
          <a href="/demo" class="lka-btn lka-btn-outline lka-btn-md">Get Started</a>
        </div>
        <div class="lka-price-card lka-price-feat">
          <span class="lka-price-badge">Popular</span>
          <h3>Professional</h3>
          <div class="lka-price-amt"><span class="lka-price-num">$79</span><span class="lka-price-per">/mo</span></div>
          <ul class="lka-price-feats">
            <li>Unlimited clients</li>
            <li>Unlimited projects</li>
            <li>Advanced invoicing</li>
            <li>Email & social integration</li>
            <li>Client portal</li>
            <li>Priority support</li>
          </ul>
          <a href="/demo" class="lka-btn lka-btn-accent lka-btn-md">Get Started</a>
        </div>
        <div class="lka-price-card">
          <h3>Enterprise</h3>
          <div class="lka-price-amt"><span class="lka-price-num">$199</span><span class="lka-price-per">/mo</span></div>
          <ul class="lka-price-feats">
            <li>Everything in Professional</li>
            <li>Custom branding</li>
            <li>API access</li>
            <li>Dedicated account manager</li>
            <li>Custom integrations</li>
            <li>SLA guarantee</li>
          </ul>
          <a href="/demo" class="lka-btn lka-btn-outline lka-btn-md">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA Band ── -->
  <section class="lka-cta-band">
    <div class="container lka-cta-inner">
      <h2 class="lka-cta-title lka-reveal">Ready to run your hustle?</h2>
      <p class="lka-cta-desc lka-reveal">Stop juggling apps. Start growing your business from one dashboard.</p>
      <div class="lka-cta-acts lka-reveal">
        <a href="/demo" class="lka-cta-light">Book a Demo →</a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section id="faq" class="section lka-faq">
    <div class="container">
      <span class="lka-label lka-reveal">FAQ</span>
      <h2 class="lka-sec-title lka-reveal">Common questions.</h2>
      <div class="lka-faq-list lka-reveal-stagger in-view">
        <details class="lka-faq-item">
          <summary>What is Hustle Zone?</summary>
          <p>Hustle Zone is an all-in-one business operating system for freelancers, solopreneurs, and small teams. It combines project management, invoicing, email, social media, and client portals into one dashboard.</p>
        </details>
        <details class="lka-faq-item">
          <summary>Can I import my existing data?</summary>
          <p>Yes. During onboarding, we'll help you import contacts, projects, and invoices from your current tools. Most migrations take less than a day.</p>
        </details>
        <details class="lka-faq-item">
          <summary>Is there a free trial?</summary>
          <p>We offer a 14-day free trial on all plans. No credit card required. Book a demo and we'll set it up for you.</p>
        </details>
        <details class="lka-faq-item">
          <summary>What kind of support do you offer?</summary>
          <p>Starter plans include community support. Professional plans include priority email support. Enterprise plans include a dedicated account manager and SLA.</p>
        </details>
        <details class="lka-faq-item">
          <summary>Can I cancel anytime?</summary>
          <p>Absolutely. No contracts, no lock-in. Cancel from your dashboard and you'll retain access until the end of your billing period.</p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* ═══════════════════════════════════════════
     Hustle Zone — LAKA Design System Reskin
     ═══════════════════════════════════════════ */

  /* ── Shared ── */
  .lka-label {
    display: inline-block;
    font-size: var(--text-micro);
    font-weight: var(--weight-regular);
    letter-spacing: var(--track-micro);
    text-transform: uppercase;
    color: var(--text-body);  /* body color, NOT accent — accent fails AA at 12px (4.38:1) */
    margin-bottom: var(--space-3);
    border: 1px solid var(--lka-hairline-soft);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
  }
  .lka-acc { color: var(--lka-accent); }
  .lka-sec-title {
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-h2);
    line-height: var(--leading-h2);
    color: var(--text-heading);
    margin-bottom: var(--space-9);
  }

  /* ── Hero ── */
  .lka-hero { padding-top: var(--space-8); position: relative; }
  .lka-hero::before {
    content: ''; position: absolute; inset: 0;
    background: var(--backlight); pointer-events: none;
  }
  .lka-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); align-items: center; position: relative; }
  .lka-hero-title {
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-display);
    line-height: var(--leading-display);
    color: var(--text-heading);
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .lka-hero-desc {
    font-size: var(--text-lg);
    color: var(--lka-muted);
    max-width: 480px;
    margin-bottom: var(--space-7);
  }
  .lka-hero-actions { display: flex; gap: var(--space-4); }

  /* ── Hero media frame ── */
  .lka-hero-media { position: relative; }
  .lka-frame {
    position: relative; aspect-ratio: 4/3;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: linear-gradient(135deg, var(--lka-raised), var(--lka-surface));
    border: 1px solid var(--lka-hairline-soft);
    padding: var(--space-7);
  }
  .lka-notch {
    position: absolute; right: 0; bottom: 0;
    width: 112px; height: 80px;
    background: var(--bg-page);
    border-top-left-radius: var(--radius-card);
    z-index: 2;
  }
  .lka-dash {
    display: flex; flex-direction: column; gap: var(--space-4);
  }
  .lka-dash-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: var(--space-3) var(--space-4);
    background: rgba(245,247,250,0.04);
    border-radius: var(--radius-control);
    border: 1px solid var(--lka-hairline-soft);
  }
  .lka-dash-lbl { font-size: var(--text-small); color: var(--text-muted); }
  .lka-dash-val { font-weight: var(--weight-semibold); color: var(--text-heading); }

  /* ── Features ── */
  .lka-features { background: var(--lka-surface); }
  .lka-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .lka-card {
    padding: var(--space-7); border-radius: var(--radius-card);
    border: 1px solid var(--lka-hairline-soft);
    background: var(--bg-page);
    transition: border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .lka-card:hover { border-color: rgba(245,247,250,0.25); transform: translateY(-2px); }
  .lka-card-icon { font-size: 32px; margin-bottom: var(--space-4); display: block; }
  .lka-card h3 { font-size: var(--text-h4); font-weight: var(--weight-semibold); color: var(--text-heading); margin-bottom: var(--space-2); }
  .lka-card p { font-size: var(--text-small); color: var(--text-muted); line-height: 1.6; }

  /* ── How It Works ── */
  .lka-how {
    background:
      var(--backlight-top),
      var(--bg-page);
  }
  .lka-steps {
    display: grid; grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center; gap: var(--space-5);
  }
  .lka-step { text-align: center; padding: var(--space-7); }
  .lka-step-num {
    display: inline-block;
    font-size: var(--text-micro);
    letter-spacing: var(--track-micro);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    color: var(--lka-accent);
    margin-bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgba(63,110,233,0.3);
    border-radius: var(--radius-pill);
  }
  .lka-step h3 { font-size: var(--text-h4); font-weight: var(--weight-semibold); color: var(--text-heading); margin-bottom: var(--space-2); }
  .lka-step p { font-size: var(--text-small); color: var(--text-muted); max-width: 300px; margin: 0 auto; }
  .lka-step-arr { font-size: 24px; color: var(--lka-accent); text-align: center; }

  /* ── Pricing ── */
  .lka-pricing {
    background: linear-gradient(180deg, var(--lka-surface), var(--bg-page));
  }
  .lka-price-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); align-items: start; }
  .lka-price-card {
    padding: var(--space-8) var(--space-7);
    border-radius: var(--radius-card);
    border: 1px solid var(--lka-hairline-soft);
    background: var(--lka-surface);
    display: flex; flex-direction: column;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .lka-price-card:hover { border-color: rgba(245,247,250,0.25); }
  .lka-price-feat {
    border-color: var(--lka-accent);
    position: relative;
    background: linear-gradient(135deg, var(--bg-page), var(--lka-surface));
    transform: scale(1.04);
    z-index: 2;
  }
  .lka-price-badge {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
    padding: 4px 20px; border-radius: var(--radius-pill);
    background: var(--lka-accent); color: #FFFFFF;
    font-size: var(--text-micro); font-weight: var(--weight-bold);
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .lka-price-card h3 { font-size: var(--text-h4); color: var(--text-heading); margin-bottom: var(--space-4); }
  .lka-price-amt { margin-bottom: var(--space-6); }
  .lka-price-num { font-size: var(--text-h2); font-weight: var(--weight-bold); color: var(--text-heading); line-height: 1; }
  .lka-price-per { font-size: var(--text-body); color: var(--text-muted); margin-left: var(--space-1); }
  .lka-price-feats { list-style: none; margin-bottom: var(--space-7); flex: 1; }
  .lka-price-feats li {
    padding: var(--space-2) 0; font-size: var(--text-small);
    color: var(--text-body);
    border-bottom: 1px solid var(--lka-hairline-soft);
  }
  .lka-price-feats li::before { content: "✓ "; color: var(--lka-accent); font-weight: var(--weight-bold); }

  /* ── CTA Band ── */
  .lka-cta-band {
    position: relative;
    background: linear-gradient(135deg, var(--lka-accent), #5588FF 50%, var(--lka-accent));
    text-align: center;
    padding: var(--space-10) 0;
    overflow: hidden;
  }
  .lka-cta-band::before {
    content: ''; position: absolute; inset: 0;
    background-image: var(--grain-url);
    opacity: var(--grain-opacity);
    pointer-events: none;
  }
  .lka-cta-inner {
    max-width: var(--container); margin: 0 auto; padding: 0 var(--gutter);
    position: relative;
  }
  .lka-cta-title {
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-h2);
    line-height: var(--leading-h2);
    color: #FFFFFF;  /* LAKA: white on accent */
    margin-bottom: var(--space-5);
  }
  .lka-cta-desc {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.85);
    max-width: 480px;
    margin: 0 auto var(--space-8);
  }
  .lka-cta-light {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 16px 36px;
    border-radius: var(--radius-pill);
    background: #FFFFFF; color: var(--lka-accent);
    font-weight: var(--weight-bold); font-size: 16px;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }
  .lka-cta-light:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(255,255,255,0.25);
  }

  /* ── FAQ ── */
  .lka-faq-list { max-width: 720px; }
  .lka-faq-item {
    border-bottom: 1px solid var(--lka-hairline-soft);
    padding: var(--space-5) 0;
  }
  .lka-faq-item summary {
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    color: var(--text-heading);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
    list-style: none;
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-2) 0;
  }
  .lka-faq-item summary::-webkit-details-marker { display: none; }
  .lka-faq-item summary::after {
    content: "+";
    font-size: 22px;
    color: var(--lka-accent);
    font-weight: var(--weight-bold);
    transition: transform var(--duration-fast) var(--ease-out);
    line-height: 1;
  }
  .lka-faq-item[open] summary::after { transform: rotate(45deg); }
  .lka-faq-item p {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 620px;
    padding-bottom: var(--space-2);
  }
  .lka-faq-item[open] { padding-bottom: var(--space-4); }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .lka-hero-grid { grid-template-columns: 1fr; }
    .lka-feat-grid { grid-template-columns: 1fr; }
    .lka-steps { grid-template-columns: 1fr; }
    .lka-steps .lka-step-arr { display: none; }
    .lka-price-grid { grid-template-columns: 1fr; }
    .lka-price-feat { transform: none; }
    .lka-hero-actions { flex-direction: column; }
  }
</style>