---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Book a Demo — Hustle Zone YEG" description="Book a demo of Hustle Zone YEG. See the platform in action.">
  <section class="section lka-demo">
    <div class="container lka-demo-grid">
      <div class="lka-demo-text lka-reveal">
        <span class="lka-label">Get started</span>
        <h1 class="lka-demo-title">See Hustle Zone<br>in <span class="lka-acc">action</span>.</h1>
        <p class="lka-demo-desc">Book a 30-minute walkthrough. We'll show you how the platform works for your specific business — no pitch, no pressure.</p>
        <ul class="lka-demo-perks">
          <li>✓ Live product demo tailored to you</li>
          <li>✓ Quick Q&A with our team</li>
          <li>✓ Free 14-day trial to follow</li>
          <li>✓ No credit card required</li>
        </ul>
      </div>
      <div class="lka-demo-form lka-reveal">
        <h2>Reserve Your Spot</h2>
        <form id="demo-form" action="https://app.emailit.app/api/v1/forms/your-form-id" method="POST">
          <div class="lka-fg">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="Your name" />
          </div>
          <div class="lka-fg">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com" />
          </div>
          <div class="lka-fg">
            <label for="business">Business Name</label>
            <input type="text" id="business" name="business" placeholder="Your business / side project" />
          </div>
          <div class="lka-fg">
            <label for="message">What would you like to see?</label>
            <textarea id="message" name="message" rows="3" placeholder="Project management, invoicing, client portal, everything..."></textarea>
          </div>
          <button type="submit" class="lka-demo-submit">Book My Demo →</button>
          <p class="lka-demo-note">No spam. Unsubscribe anytime.</p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .lka-demo-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: var(--space-8); align-items: start;
  }
  .lka-demo-title {
    font-size: var(--text-display); font-weight: var(--weight-semibold);
    letter-spacing: var(--track-display); line-height: var(--leading-display);
    color: var(--text-heading); margin-top: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .lka-demo-desc {
    font-size: var(--text-lg); color: var(--text-muted);
    margin-bottom: var(--space-6);
  }
  .lka-demo-perks { list-style: none; margin-bottom: var(--space-6); }
  .lka-demo-perks li {
    padding: var(--space-2) 0; font-size: var(--text-small);
    color: var(--text-body);
  }
  .lka-demo-form {
    padding: var(--space-7); border-radius: var(--radius-panel);
    border: 1px solid var(--lka-hairline);
    background: var(--lka-surface);
  }
  .lka-demo-form h2 {
    font-size: var(--text-h3); font-weight: var(--weight-semibold);
    color: var(--text-heading); margin-bottom: var(--space-6);
  }
  .lka-fg { margin-bottom: var(--space-5); }
  .lka-fg label {
    display: block; font-size: var(--text-small);
    font-weight: var(--weight-semibold); color: var(--text-heading);
    margin-bottom: var(--space-2);
  }
  .lka-fg input,
  .lka-fg textarea {
    width: 100%; padding: 12px 16px;
    border-radius: var(--radius-control);
    border: 1px solid var(--lka-hairline);
    background: var(--lka-raised);
    color: var(--text-heading);
    font-family: var(--font-core);
    font-size: var(--text-body);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .lka-fg input::placeholder,
  .lka-fg textarea::placeholder { color: var(--text-muted); }
  .lka-fg input:focus,
  .lka-fg textarea:focus {
    outline: none; border-color: var(--lka-accent);
  }
  .lka-demo-submit {
    width: 100%; padding: 14px 24px;
    border: none; border-radius: var(--radius-control);
    background: var(--lka-accent); color: #FFFFFF;
    font-family: var(--font-core); font-size: var(--text-body);
    font-weight: var(--weight-semibold); cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .lka-demo-submit:hover { background: var(--lka-accent-hover); }
  .lka-demo-note {
    margin-top: var(--space-3); text-align: center;
    font-size: var(--text-small); color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .lka-demo-grid { grid-template-columns: 1fr; }
  }
</style>