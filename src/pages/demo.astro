---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Book a Demo — Hustle Zone YEG" description="Book a demo of Hustle Zone YEG. See the platform in action.">
  <section class="section demo-section">
    <div class="container demo-grid">
      <div class="demo-text rp-reveal">
        <span class="section-label">GET STARTED</span>
        <h1 class="demo-title">See Hustle Zone<br/>in <span class="accent">action</span>.</h1>
        <p class="demo-desc">Book a 30-minute walkthrough. We'll show you how the platform works for your specific business — no pitch, no pressure.</p>
        <ul class="demo-perks">
          <li>✓ Live product demo tailored to you</li>
          <li>✓ Quick Q&A with our team</li>
          <li>✓ Free 14-day trial to follow</li>
          <li>✓ No credit card required</li>
        </ul>
      </div>
      <div class="demo-form rp-reveal">
        <h2>Reserve Your Spot</h2>
        <form id="demo-form" action="https://app.emailit.app/api/v1/forms/your-form-id" method="POST">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="Your name" />
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com" />
          </div>
          <div class="form-group">
            <label for="business">Business Name</label>
            <input type="text" id="business" name="business" placeholder="Your business / side project" />
          </div>
          <div class="form-group">
            <label for="message">What would you like to see?</label>
            <textarea id="message" name="message" rows="3" placeholder="Project management, invoicing, client portal, everything..."></textarea>
          </div>
          <button type="submit" class="form-submit">Book My Demo →</button>
          <p class="form-note">No spam. Unsubscribe anytime.</p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .demo-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: var(--space-8); align-items: start;
  }
  .demo-title {
    font-size: var(--text-h1); font-weight: var(--weight-semibold);
    letter-spacing: var(--track-h1); line-height: var(--leading-h1);
    color: var(--text-heading); margin-bottom: var(--space-5);
  }
  .demo-desc {
    font-size: var(--text-body-lg); color: var(--text-muted);
    margin-bottom: var(--space-6);
  }
  .demo-perks { list-style: none; margin-bottom: var(--space-6); }
  .demo-perks li {
    padding: var(--space-2) 0; font-size: var(--text-small);
    color: var(--text-body);
  }
  .demo-perks li::before { content: ""; } /* ✓ already in content */
  .demo-form {
    padding: var(--space-7); border-radius: var(--radius-panel);
    border: 1px solid var(--hairline);
    background: var(--surface-card);
  }
  .demo-form h2 {
    font-size: var(--text-h3); font-weight: var(--weight-semibold);
    color: var(--text-heading); margin-bottom: var(--space-6);
  }
  .form-group { margin-bottom: var(--space-5); }
  .form-group label {
    display: block; font-size: var(--text-small);
    font-weight: var(--weight-semibold); color: var(--text-heading);
    margin-bottom: var(--space-2);
  }
  .form-group input,
  .form-group textarea {
    width: 100%; padding: 12px 16px;
    border-radius: var(--radius-input);
    border: 1px solid var(--hairline);
    background: var(--rp-surface-2);
    color: var(--text-heading);
    font-family: var(--font-core);
    font-size: var(--size-body);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .form-group input::placeholder,
  .form-group textarea::placeholder { color: var(--text-muted); }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none; border-color: var(--rp-accent);
  }
  .form-submit {
    width: 100%; padding: 14px 24px;
    border: none; border-radius: var(--radius-btn);
    background: var(--cta); color: var(--rp-on-accent);
    font-family: var(--font-core); font-size: var(--size-body);
    font-weight: var(--weight-semibold); cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .form-submit:hover { background: var(--rp-accent-hover); }
  .form-note {
    margin-top: var(--space-3); text-align: center;
    font-size: var(--text-small); color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .demo-grid { grid-template-columns: 1fr; }
  }
</style>